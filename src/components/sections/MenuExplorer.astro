---
import { allMenuItems } from "../../data/menu";
import type { Language } from "../../data/site";
import { site } from "../../data/site";

interface Props {
  lang: Language;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const visibleItems = compact ? allMenuItems.slice(0, 12) : allMenuItems;
const filters = ["All", "Pasta Fresca", "Pinsa Romana", "Salads", "Sides", "Dessert", "Vegetarian", "Spicy"];
const copy = {
  en: {
    eyebrow: "Menu preview",
    title: "Real dishes, clear prices",
    intro: "Filter by category or badge. Tap a dish for details.",
    details: "View details",
    directions: "Get directions",
    close: "Close",
    allMenu: "Open full menu",
  },
  it: {
    eyebrow: "Anteprima menu",
    title: "Piatti reali, prezzi chiari",
    intro: "Filtra per categoria o badge. Tocca un piatto per i dettagli.",
    details: "Dettagli",
    directions: "Indicazioni",
    close: "Chiudi",
    allMenu: "Apri menu completo",
  },
}[lang];
---

<section id="menu-preview" class="bg-paper px-4 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">{copy.title}</h2>
        <p class="mt-3 leading-7 text-ink/65">{copy.intro}</p>
      </div>
      {compact && <a href={`/${lang}/menu`} class="rounded-full bg-tomato px-6 py-3 text-sm font-bold text-white shadow-lg shadow-tomato/20">{copy.allMenu}</a>}
    </div>

    <div class="mt-8 flex gap-2 overflow-x-auto pb-2" role="tablist" aria-label="Menu filters">
      {filters.map((filter, index) => (
        <button
          type="button"
          class:list={[
            "menu-filter shrink-0 rounded-full border px-4 py-2 text-sm font-bold transition",
            index === 0 ? "border-tomato bg-tomato text-white" : "border-ink/10 bg-white text-ink/70 hover:border-tomato hover:text-tomato",
          ]}
          data-filter={filter}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {filter}
        </button>
      ))}
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {visibleItems.map((item) => (
        <article
          class="menu-card group overflow-hidden rounded-3xl border border-ink/10 bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl"
          data-category={item.category}
          data-badges={item.badges.join(",")}
          data-item={JSON.stringify(item)}
        >
          <button type="button" class="menu-card-open block w-full text-left" aria-label={`${copy.details}: ${item.name}`}>
            <div class="overflow-hidden bg-cream p-4">
              <img src={item.image} alt={`${item.name}: ${item.ingredients}`} loading="lazy" class="aspect-[4/3] w-full object-contain transition duration-500 group-hover:scale-[1.03]" />
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-2xl font-semibold">{item.name}</h3>
                <p class="shrink-0 text-lg font-bold text-tomato">{item.priceLabel}</p>
              </div>
              <p class="mt-2 min-h-12 text-sm leading-6 text-ink/60">{item.ingredients}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {item.badges.map((badge) => (
                  <span class:list={[
                    "rounded-full px-3 py-1 text-xs font-bold",
                    badge.includes("Spicy") ? "bg-tomato/10 text-tomato" : badge === "Vegetarian" ? "bg-mint/35 text-olive" : "bg-wood/35 text-ink",
                  ]}>
                    {badge}
                  </span>
                ))}
              </div>
              <p class="mt-5 text-sm font-bold text-tomato">{copy.details} →</p>
            </div>
          </button>
        </article>
      ))}
    </div>
  </div>

  <dialog id="dish-modal" class="w-[min(92vw,56rem)] rounded-3xl border border-ink/10 bg-paper p-0 shadow-2xl backdrop:bg-ink/55">
    <div class="grid overflow-hidden md:grid-cols-[0.9fr_1.1fr]">
      <div class="grid min-h-72 place-items-center bg-cream p-6">
        <img id="modal-image" src="" alt="" class="h-full max-h-[32rem] w-full object-contain" />
      </div>
      <div class="p-6 sm:p-8">
        <p id="modal-category" class="eyebrow"></p>
        <h3 id="modal-name" class="mt-2 font-display text-4xl font-semibold"></h3>
        <p id="modal-ingredients" class="mt-4 leading-7 text-ink/65"></p>
        <p id="modal-price" class="mt-5 text-3xl font-bold text-tomato"></p>
        <div id="modal-badges" class="mt-5 flex flex-wrap gap-2"></div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.googleMapsUrl} class="rounded-full bg-tomato px-6 py-3 text-sm font-bold text-white">{copy.directions}</a>
          <button id="modal-close" type="button" class="rounded-full bg-white px-6 py-3 text-sm font-bold text-ink ring-1 ring-ink/10">{copy.close}</button>
        </div>
      </div>
    </div>
  </dialog>

  <script>
    type MenuItem = {
      id: string;
      category: string;
      name: string;
      ingredients: string;
      priceLabel: string;
      image: string;
      badges: string[];
    };

    const filters = [...document.querySelectorAll<HTMLButtonElement>(".menu-filter")];
    const cards = [...document.querySelectorAll<HTMLElement>(".menu-card")];
    const modal = document.querySelector<HTMLDialogElement>("#dish-modal");
    const modalImage = document.querySelector<HTMLImageElement>("#modal-image");
    const modalCategory = document.querySelector<HTMLElement>("#modal-category");
    const modalName = document.querySelector<HTMLElement>("#modal-name");
    const modalIngredients = document.querySelector<HTMLElement>("#modal-ingredients");
    const modalPrice = document.querySelector<HTMLElement>("#modal-price");
    const modalBadges = document.querySelector<HTMLElement>("#modal-badges");
    const close = document.querySelector<HTMLButtonElement>("#modal-close");

    const applyFilter = (filter: string) => {
      filters.forEach((button) => {
        const active = button.dataset.filter === filter;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-tomato", active);
        button.classList.toggle("text-white", active);
        button.classList.toggle("border-tomato", active);
        button.classList.toggle("bg-white", !active);
        button.classList.toggle("text-ink/70", !active);
      });

      cards.forEach((card) => {
        const badges = card.dataset.badges ?? "";
        const category = card.dataset.category ?? "";
        const show = filter === "All" || category === filter || badges.includes(filter);
        card.hidden = !show;
      });
    };

    filters.forEach((button) => {
      button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "All"));
    });

    document.querySelectorAll<HTMLElement>(".menu-card-open").forEach((button) => {
      button.addEventListener("click", () => {
        const card = button.closest<HTMLElement>(".menu-card");
        const item = JSON.parse(card?.dataset.item ?? "{}") as MenuItem;
        if (!modal || !modalImage || !modalCategory || !modalName || !modalIngredients || !modalPrice || !modalBadges) return;
        modalImage.src = item.image;
        modalImage.alt = `${item.name}: ${item.ingredients}`;
        modalCategory.textContent = item.category;
        modalName.textContent = item.name;
        modalIngredients.textContent = item.ingredients;
        modalPrice.textContent = item.priceLabel;
        modalBadges.innerHTML = item.badges
          .map((badge) => `<span class="rounded-full bg-mint/35 px-3 py-1 text-xs font-bold text-olive">${badge}</span>`)
          .join("");
        modal.showModal();
      });
    });

    close?.addEventListener("click", () => modal?.close());
    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  </script>
</section>
