---
import { allMenuItems } from "../../data/menu";
import { site } from "../../data/site";
import type { Language } from "../../data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const menuHref = `/${lang}/menu`;
const copy = {
  en: {
    nav: ["Home", "Menu", "Pinsa", "Pasta", "Location", "Reviews"],
    eyebrow: "Cucina Romana · Via Cavour 153",
    headlineA: "Roman",
    headlineB: "Pasta",
    headlineC: "Served with",
    headlineAccent: "Heart.",
    subtitle: "Fresh pasta, pinsa romana and supplì made for a fast, warm stop in the heart of Rome.",
    viewMenu: "View Menu",
    directions: "Get Directions",
    order: "Order / Contact",
    ingredients: "Ingredients",
    scrollView: "Scroll",
    gridView: "Grid",
  },
  it: {
    nav: ["Home", "Menu", "Pinsa", "Pasta", "Location", "Reviews"],
    eyebrow: "Cucina Romana · Via Cavour 153",
    headlineA: "Pasta",
    headlineB: "Romana",
    headlineC: "Servita con",
    headlineAccent: "Cuore.",
    subtitle: "Pasta fresca, pinsa romana e supplì per una pausa calda e veloce nel cuore di Roma.",
    viewMenu: "Vedi Menu",
    directions: "Indicazioni",
    order: "Ordina / Contatti",
    ingredients: "Ingredienti",
    scrollView: "Lista",
    gridView: "Griglia",
  },
}[lang];
const navLinks = copy.nav.map((item) => ({
  label: item,
  href: item === "Home" ? `/${lang}` : item === "Location" ? "#location" : item === "Reviews" ? "#trust" : `${menuHref}#${item.toLowerCase()}`,
}));
const heroGroups = [
  {
    id: "pasta",
    label: "Pasta",
    items: allMenuItems.filter((item) => item.category === "Pasta Fresca"),
  },
  {
    id: "pinsa",
    label: "Pinsa",
    items: allMenuItems.filter((item) => item.category === "Pinsa Romana"),
  },
  {
    id: "starters",
    label: lang === "it" ? "Antipasti" : "Starters",
    items: allMenuItems.filter((item) => ["Sides", "Salads", "Dessert"].includes(item.category)),
  },
];
const heroMenuItems = heroGroups.flatMap((group) => group.items.map((item) => ({ ...item, heroGroup: group.id })));
const activeItem = heroMenuItems[0];
---

<section class="hero-shell relative isolate min-h-screen overflow-hidden bg-[#f7f3ec] px-3 pb-12 pt-5 text-ink sm:px-4">
  <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-white/65 to-transparent"></div>

  <header class="hero-logo relative z-20 mx-auto flex w-full max-w-[calc(100vw-1.5rem)] items-center justify-between rounded-full border border-ink/5 bg-white/72 px-4 py-2.5 shadow-sm backdrop-blur-md sm:max-w-[calc(100vw-2rem)] sm:px-6">
    <a href={`/${lang}`} class="flex items-center gap-3" aria-label={`${site.name} home`}>
      <img src="/images/pomodorum-logo.jpg" alt={site.name} class="h-11 w-auto rounded-full bg-white p-1 ring-1 ring-ink/5" />
      <span class="hidden font-display text-xl font-semibold text-ink sm:block">POMODORUM ROMA</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-semibold lg:flex">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class:list={["transition hover:text-tomato", item.label === "Home" ? "text-tomato" : "text-ink/70"]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href={site.googleMapsUrl} class="hidden rounded-full bg-tomato px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#981d19] sm:inline-flex">
      {copy.directions}
    </a>
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-white text-ink shadow-sm lg:hidden"
    >
      <span class="grid gap-1.5">
        <span class="block h-0.5 w-5 rounded-full bg-current"></span>
        <span class="block h-0.5 w-5 rounded-full bg-current"></span>
        <span class="block h-0.5 w-5 rounded-full bg-current"></span>
      </span>
    </button>
  </header>

  <div id="mobile-menu" class="relative z-20 mx-auto mt-3 hidden w-full max-w-[calc(100vw-1.5rem)] rounded-3xl border border-ink/10 bg-paper/98 p-4 shadow-soft backdrop-blur sm:max-w-[calc(100vw-2rem)] lg:hidden">
    <nav class="grid gap-1 text-sm font-bold">
      {navLinks.map((item) => (
        <a href={item.href} class="rounded-2xl px-4 py-3 text-ink/75 transition hover:bg-cream hover:text-tomato">{item.label}</a>
      ))}
    </nav>
    <a href={site.googleMapsUrl} class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-tomato px-5 text-sm font-bold text-white shadow-lg shadow-tomato/20">
      {copy.directions}
    </a>
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-none items-center gap-8 pb-8 pt-12 lg:min-h-[calc(100vh-7rem)] lg:grid-cols-[minmax(22rem,0.62fr)_minmax(40rem,1fr)_minmax(19rem,0.46fr)] lg:gap-0 lg:pt-4">
    <div class="hero-copy relative z-10 text-center lg:-translate-x-2 lg:text-left xl:-translate-x-5">
      <p class="hero-eyebrow mb-6 text-xs font-black uppercase tracking-[0.42em] text-tomato sm:text-sm">{copy.eyebrow}</p>
      <h1 class="font-display text-5xl font-semibold leading-[0.9] text-ink sm:text-7xl lg:text-[5.45rem] xl:text-[6.1rem]">
        <span class="hero-line block">{copy.headlineA}</span>
        <span class="hero-line block">{copy.headlineB}</span>
        <span class="hero-line block whitespace-nowrap">{copy.headlineC}</span>
        <span class="hero-line block text-tomato">{copy.headlineAccent}</span>
      </h1>
      <div class="hero-subtitle mx-auto mt-8 max-w-md text-left lg:mx-0">
        <p class="hero-subtitle-copy text-lg font-medium leading-8 text-ink/65 sm:text-xl">{copy.subtitle}</p>
      </div>
      <div class="hero-actions mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
        <a href={menuHref} class="inline-flex min-h-12 items-center justify-center rounded-full bg-tomato px-7 text-sm font-bold text-white shadow-sm transition hover:-translate-y-1 hover:bg-[#981d19]">
          <span class="mr-2">→</span>{copy.viewMenu}
        </a>
        <a href={site.googleMapsUrl} class="inline-flex min-h-12 items-center justify-center rounded-full bg-white/80 px-7 text-sm font-bold text-tomato shadow-sm ring-1 ring-ink/10 transition hover:-translate-y-1 hover:bg-white">
          <span class="mr-2">→</span>{copy.directions}
        </a>
        <a href={site.phoneHref} class="inline-flex min-h-12 items-center justify-center rounded-full bg-olive px-7 text-sm font-bold text-white shadow-sm transition hover:-translate-y-1 hover:bg-frame">
          {copy.order}
        </a>
      </div>
    </div>

    <div class="hero-visual relative order-first min-h-[24rem] overflow-visible lg:order-none lg:min-h-[43rem]">
      {heroMenuItems.map((item, index) => (
        <figure
          class:list={[
            "hero-food absolute left-1/2 top-1/2 w-[min(92vw,34rem)] -translate-x-1/2 -translate-y-1/2 lg:w-[39rem] xl:w-[41rem]",
            index === 0 ? "is-active" : "",
          ]}
          data-hero-index={index}
        >
          <img src={item.image} alt={`${item.name}: ${item.ingredients}`} class="h-auto w-full object-contain drop-shadow-2xl" loading={index === 0 ? "eager" : "lazy"} />
        </figure>
      ))}
      <div class="hero-cta absolute bottom-0 left-1/2 z-10 hidden w-[min(34rem,90vw)] -translate-x-1/2 items-start gap-5 rounded-[2rem] bg-white/88 px-7 py-5 text-ink shadow-xl ring-1 ring-ink/10 backdrop-blur lg:flex">
        <span id="hero-price" class="shrink-0 rounded-full bg-tomato px-5 py-3 text-xl font-black text-white shadow-sm">{activeItem.priceLabel}</span>
        <span class="min-w-0">
          <span class="block text-xs font-black uppercase tracking-[0.22em] text-tomato">{copy.ingredients}</span>
          <span id="hero-ingredients" class="mt-1 block text-sm font-semibold leading-6 text-ink/65">{activeItem.ingredients}</span>
        </span>
      </div>
    </div>

    <div id="hero-menu-panel" class="hero-cards absolute right-[-0.75rem] top-1/2 z-20 hidden w-[41rem] -translate-y-1/2 flex-col gap-4 lg:flex xl:right-[-1rem] xl:w-[43rem]">
      <div class="hero-view-toggle ml-auto mr-5 flex w-max rounded-full border border-ink/10 bg-white/80 p-1 shadow-sm">
        <button type="button" class="hero-view-button rounded-full bg-tomato px-5 py-2 text-xs font-black uppercase tracking-[0.16em] text-white" data-view="scroll">{copy.scrollView}</button>
        <button type="button" class="hero-view-button rounded-full px-5 py-2 text-xs font-black uppercase tracking-[0.16em] text-ink/55" data-view="grid" data-href={menuHref}>{copy.gridView}</button>
      </div>
      <div class="hero-category-tabs flex justify-center gap-3 pr-5">
        {heroGroups.map((group, index) => (
          <button
            type="button"
            class:list={[
              "hero-category-tab rounded-full border px-8 py-4 text-sm font-black uppercase tracking-[0.16em] transition",
              index === 0 ? "is-active border-tomato bg-tomato text-white" : "border-ink/10 bg-white/75 text-ink/60 hover:border-tomato hover:text-tomato",
            ]}
            data-category={group.id}
          >
            {group.label}
          </button>
        ))}
      </div>
      <div id="hero-card-list" class="hero-card-list flex max-h-[32rem] flex-col gap-4 overflow-y-auto py-1 pl-1 pr-5">
        {heroMenuItems.map((item, index) => (
          <button
            type="button"
            class:list={[
              "hero-product-card relative min-h-28 w-full rounded-l-full bg-paper py-5 pl-5 pr-10 text-left shadow-soft transition",
              index === 0 ? "is-active" : "",
              item.heroGroup !== heroGroups[0].id ? "hidden" : "",
            ]}
            data-card-index={index}
            data-category={item.heroGroup}
            data-price={item.priceLabel}
            data-ingredients={item.ingredients}
          >
            <span class="absolute left-5 top-1/2 grid aspect-square w-20 -translate-y-1/2 place-items-center rounded-full bg-white shadow-md ring-8 ring-white/60">
              <img src={item.image} alt="" class="h-16 w-16 object-contain" loading={index === 0 ? "eager" : "lazy"} />
            </span>
            <span class="block pl-[7.25rem]">
              <span class="block text-2xl font-black uppercase tracking-wide">{item.name}</span>
              <span class="mt-2 block text-sm font-bold opacity-75">{item.priceLabel}</span>
            </span>
            <span class="hero-grid-details mt-3 hidden text-center">
              <span class="block text-sm font-semibold leading-6 text-ink/65">{item.ingredients}</span>
              <span class="mt-3 inline-flex rounded-full bg-tomato px-4 py-2 text-sm font-black text-white">{item.priceLabel}</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto flex max-w-7xl gap-3 overflow-x-auto pb-2 lg:hidden">
    {heroMenuItems.slice(0, 12).map((item) => (
      <article class="min-w-56 rounded-2xl border border-ink/10 bg-paper p-4 shadow-md">
        <p class="font-display text-xl font-semibold">{item.name}</p>
        <p class="mt-1 text-sm text-ink/60">{item.ingredients}</p>
        <p class="mt-2 font-bold text-tomato">{item.priceLabel}</p>
      </article>
    ))}
  </div>

  <script>
    const heroFoods = [...document.querySelectorAll<HTMLElement>(".hero-food")];
    const heroCards = [...document.querySelectorAll<HTMLButtonElement>(".hero-product-card")];
    const heroCategoryTabs = [...document.querySelectorAll<HTMLButtonElement>(".hero-category-tab")];
    const heroViewButtons = [...document.querySelectorAll<HTMLButtonElement>(".hero-view-button")];
    const heroShell = document.querySelector<HTMLElement>(".hero-shell");
    const heroMenuPanel = document.querySelector<HTMLElement>("#hero-menu-panel");
    const heroCardList = document.querySelector<HTMLElement>("#hero-card-list");
    const heroPrice = document.querySelector<HTMLElement>("#hero-price");
    const heroIngredients = document.querySelector<HTMLElement>("#hero-ingredients");
    const mobileToggle = document.querySelector<HTMLButtonElement>("#mobile-menu-toggle");
    const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let activeHero = 0;
    let activeCategory = "pasta";
    let activeView = "scroll";

    const setHero = (index: number) => {
      heroFoods[activeHero]?.classList.remove("is-active");
      heroCards[activeHero]?.classList.remove("is-active");
      activeHero = index;
      heroFoods[activeHero]?.classList.add("is-active");
      heroCards[activeHero]?.classList.add("is-active");
      if (heroPrice) heroPrice.textContent = heroCards[activeHero]?.dataset.price ?? "";
      if (heroIngredients) heroIngredients.textContent = heroCards[activeHero]?.dataset.ingredients ?? "";
    };

    const expandGridCard = (card: HTMLButtonElement) => {
      heroCards.forEach((item) => {
        if (item !== card) item.classList.remove("is-expanded");
      });
      card.classList.toggle("is-expanded");
    };

    const visibleCards = () => heroCards.filter((card) => !card.classList.contains("hidden"));

    const setCategory = (category: string) => {
      activeCategory = category;
      heroCategoryTabs.forEach((tab) => {
        const active = tab.dataset.category === category;
        tab.classList.toggle("is-active", active);
        tab.classList.toggle("border-tomato", active);
        tab.classList.toggle("bg-tomato", active);
        tab.classList.toggle("text-white", active);
        tab.classList.toggle("border-ink/10", !active);
        tab.classList.toggle("bg-white/75", !active);
        tab.classList.toggle("text-ink/60", !active);
      });

      if (activeView === "scroll") {
        heroCards.forEach((card) => {
          card.classList.toggle("hidden", card.dataset.category !== category);
        });
      }

      heroCardList?.scrollTo({ top: 0, behavior: "smooth" });
      const firstCard = visibleCards()[0];
      if (firstCard?.dataset.cardIndex) setHero(Number(firstCard.dataset.cardIndex));
    };

    const setView = (view: string) => {
      if (view === "grid") {
        const href = heroViewButtons.find((button) => button.dataset.view === "grid")?.dataset.href;
        if (href) window.location.href = href;
        return;
      }

      activeView = view;
      heroShell?.classList.remove("is-grid-view");
      heroMenuPanel?.classList.remove("is-grid-mode");
      heroViewButtons.forEach((button) => {
        const active = button.dataset.view === view;
        button.classList.toggle("bg-tomato", active);
        button.classList.toggle("text-white", active);
        button.classList.toggle("text-ink/55", !active);
      });

      heroCards.forEach((card) => card.classList.remove("is-expanded"));
      setCategory(activeCategory);
      heroCardList?.scrollTo({ top: 0, behavior: "smooth" });
    };

    mobileToggle?.addEventListener("click", () => {
      const open = mobileToggle.getAttribute("aria-expanded") === "true";
      mobileToggle.setAttribute("aria-expanded", String(!open));
      mobileMenu?.classList.toggle("hidden", open);
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileToggle?.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
      });
    });

    heroCards.forEach((card, index) => {
      card.addEventListener("click", () => {
        setHero(index);
        if (activeView === "grid") expandGridCard(card);
      });
      card.addEventListener("mouseenter", () => {
        if (activeView !== "grid") setHero(index);
      });
    });

    heroCategoryTabs.forEach((tab) => {
      tab.addEventListener("click", () => setCategory(tab.dataset.category ?? "pasta"));
    });

    heroViewButtons.forEach((button) => {
      button.addEventListener("click", () => setView(button.dataset.view ?? "scroll"));
    });

    if (!reduceMotion && heroFoods.length > 1) {
      window.setInterval(() => {
        if (activeView === "grid") return;
        const cards = visibleCards();
        const currentVisibleIndex = cards.findIndex((card) => Number(card.dataset.cardIndex) === activeHero);
        const nextCard = cards[(currentVisibleIndex + 1) % cards.length];
        if (nextCard?.dataset.cardIndex) setHero(Number(nextCard.dataset.cardIndex));
      }, 4600);
    }
  </script>
</section>

<style>
  .hero-logo,
  .hero-copy,
  .hero-visual {
    animation: hero-fade-up 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-copy {
    animation-delay: 60ms;
  }

  .hero-visual {
    animation-delay: 180ms;
  }

  .hero-eyebrow {
    animation: hero-small-fade 180ms ease-out 90ms both;
  }

  .hero-line {
    width: fit-content;
    max-width: 100%;
    animation: hero-type-line 190ms steps(16, end) both;
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  .hero-line:nth-child(1) {
    animation: hero-roman-fade 190ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both;
  }

  .hero-line:nth-child(2) {
    animation-delay: 290ms;
  }

  .hero-line:nth-child(3) {
    animation-delay: 440ms;
  }

  .hero-line:nth-child(4) {
    animation-delay: 590ms;
  }

  .hero-subtitle-copy {
    animation: hero-type-line 220ms steps(54, end) 730ms both;
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  .hero-actions > a {
    animation: hero-cta-fade 220ms ease-out both;
    opacity: 0;
  }

  .hero-actions > a:nth-child(1) {
    animation-delay: 760ms;
  }

  .hero-actions > a:nth-child(2) {
    animation-delay: 880ms;
  }

  .hero-actions > a:nth-child(3) {
    animation-delay: 1000ms;
  }

  .hero-food {
    opacity: 0;
    transform: translate(-38%, -45%) translateY(44px) scale(0.9) rotate(-3deg);
    transition:
      opacity 500ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-food.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) translateY(0) scale(1) rotate(0);
    animation:
      hero-dish-pop 420ms cubic-bezier(0.22, 1, 0.36, 1),
      food-float 5s ease-in-out 420ms infinite;
  }

  .hero-product-card {
    color: #201b17;
    opacity: 0.72;
    transform: translateX(22px) scale(0.97);
  }

  .hero-product-card:hover {
    opacity: 1;
    transform: translateX(2px) scale(0.99);
  }

  .hero-product-card.is-active {
    opacity: 1;
    transform: translateX(-6px) scale(1);
    background: #ef4b2a;
    color: #fff;
  }

  .hero-card-list {
    scrollbar-width: thin;
    scrollbar-color: rgba(198, 37, 32, 0.55) rgba(32, 27, 23, 0.08);
  }

  .hero-card-list::-webkit-scrollbar {
    width: 10px;
  }

  .hero-card-list::-webkit-scrollbar-track {
    background: rgba(32, 27, 23, 0.08);
    border-radius: 999px;
  }

  .hero-card-list::-webkit-scrollbar-thumb {
    background: rgba(198, 37, 32, 0.6);
    border-radius: 999px;
  }

  .hero-cards.is-grid-mode {
    left: 0.75rem;
    right: -1rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: auto;
    max-height: none;
    transform: none;
    gap: 0.7rem;
    border: 1px solid rgba(255, 250, 244, 0.12);
    border-right: 0;
    border-radius: 1.5rem 0 0 1.5rem;
    background: #201813;
    padding: 1rem 0 1rem 1rem;
    box-shadow: -18px 18px 56px rgba(32, 27, 23, 0.22);
  }

  .hero-cards.is-grid-mode .hero-view-toggle {
    margin-inline: auto 1.25rem;
    background: #fffaf4;
  }

  .hero-cards.is-grid-mode .hero-category-tabs {
    display: none;
  }

  .hero-cards.is-grid-mode .hero-card-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-content: start;
    max-height: none;
    gap: 0.55rem;
    overflow: visible;
    padding: 0.25rem 1.25rem 0.25rem 0.25rem;
  }

  .hero-cards.is-grid-mode .hero-product-card {
    min-height: 8.2rem;
    width: 100%;
    border: 1px solid rgba(255, 250, 244, 0.14);
    border-radius: 0.9rem;
    background: #2b211b;
    color: #fffaf4;
    padding: 0.8rem;
    text-align: center;
    transform: none;
    opacity: 1;
    box-shadow: none;
  }

  .hero-cards.is-grid-mode .hero-product-card > span:first-child {
    position: relative;
    left: auto;
    top: auto;
    margin-inline: auto;
    width: 4.75rem;
    background: #fffaf4;
    transform: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .hero-cards.is-grid-mode .hero-product-card > span:first-child img {
    height: 3.85rem;
    width: 3.85rem;
    transition: transform 180ms ease;
  }

  .hero-cards.is-grid-mode .hero-product-card > span:nth-child(2) {
    padding-left: 0;
    margin-top: 0.55rem;
  }

  .hero-cards.is-grid-mode .hero-product-card > span:nth-child(2) span:first-child {
    font-size: 1.05rem;
    line-height: 1.18rem;
  }

  .hero-cards.is-grid-mode .hero-product-card:hover {
    transform: none;
    border-color: rgba(255, 250, 244, 0.24);
    box-shadow: none;
  }

  .hero-cards.is-grid-mode .hero-product-card.is-expanded {
    z-index: 40;
    transform: none;
    border-color: rgba(198, 37, 32, 0.34);
    background: #fffaf4;
    color: #201813;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.28);
  }

  .hero-cards.is-grid-mode .hero-product-card.is-expanded > span:first-child {
    transform: scale(1.7);
    box-shadow: 0 22px 48px rgba(32, 27, 23, 0.22);
  }

  .hero-cards.is-grid-mode .hero-product-card.is-expanded > span:first-child img {
    transform: scale(1.12);
  }

  .hero-cards.is-grid-mode .hero-product-card.is-expanded .hero-grid-details {
    display: block;
    transform: scale(1.04);
  }

  .hero-cards.is-grid-mode .hero-grid-details {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    top: calc(100% - 0.35rem);
    z-index: 50;
    border: 1px solid rgba(32, 24, 19, 0.1);
    border-radius: 1rem;
    background: #fffaf4;
    padding: 0.8rem;
