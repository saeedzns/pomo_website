---
import { featuredDishes } from "../../data/menu";
import { dictionary } from "../../data/i18n";
import type { Language } from "../../data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = dictionary[lang];
const initial = featuredDishes[0];
---

<section id="table" class="bg-paper/70 py-14 sm:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.home.showcaseEyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold sm:text-6xl">{t.home.showcaseTitle}</h2>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-3">
        {featuredDishes.map((dish) => (
          <button
            type="button"
            class="dish-thumb group relative flex cursor-grab flex-col items-center gap-2 text-center active:cursor-grabbing"
            draggable="true"
            data-dish={JSON.stringify(dish)}
            aria-label={`Show ${dish.name}`}
          >
            <span class="aspect-square w-full overflow-hidden rounded-full bg-cream shadow-md ring-1 ring-ink/10 transition group-hover:-translate-y-1 group-hover:shadow-xl">
              <img src={dish.image} alt={dish.name} loading="lazy" draggable="false" class="h-full w-full object-cover" />
            </span>
            <span class="text-xs font-bold text-ink">{dish.name}</span>
          </button>
        ))}
      </div>

      <div class="flex justify-center">
        <div
          id="wooden-table"
          class="relative aspect-square w-[300px] shrink-0 overflow-hidden rounded-full bg-cover bg-center shadow-2xl ring-1 ring-ink/20 transition sm:w-[420px] lg:w-[480px]"
          style="background-image: url('/images/wooden-table.jpg')"
          aria-label={t.home.dropHint}
        >
          <img
            id="served-image"
            src={initial.image}
            alt={initial.name}
            class="absolute left-1/2 top-1/2 h-[72%] w-[72%] -translate-x-1/2 -translate-y-1/2 rounded-full object-cover shadow-xl ring-4 ring-white/45 transition duration-300"
            draggable="false"
          />
          <span id="drop-hint" class="pointer-events-none absolute inset-x-8 bottom-8 rounded-full bg-white/75 px-4 py-2 text-center text-[10px] font-bold uppercase tracking-[0.22em] text-ink/70 backdrop-blur">
            {t.home.dropHint}
          </span>
        </div>
      </div>
    </div>

    <article id="served-details" class="surface mx-auto mt-10 max-w-2xl rounded-lg p-6 text-center sm:p-8">
      <p id="served-category" class="eyebrow">{initial.category}</p>
      <h3 id="served-name" class="mt-2 font-display text-4xl font-bold">{initial.name}</h3>
      <p id="served-ingredients" class="mt-3 leading-7 text-ink/65">{initial.ingredients}</p>
      <p id="served-price" class="mt-4 font-display text-3xl font-bold text-tomato">{initial.price}</p>
    </article>
  </div>

  <script>
    type Dish = {
      name: string;
      category: string;
      ingredients: string;
      price: string;
      image: string;
    };

    const table = document.querySelector<HTMLElement>("#wooden-table");
    const image = document.querySelector<HTMLImageElement>("#served-image");
    const category = document.querySelector<HTMLElement>("#served-category");
    const name = document.querySelector<HTMLElement>("#served-name");
    const ingredients = document.querySelector<HTMLElement>("#served-ingredients");
    const price = document.querySelector<HTMLElement>("#served-price");

    const serve = (dish: Dish) => {
      if (!image || !category || !name || !ingredients || !price) return;
      image.style.opacity = "0";
      image.style.transform = "translate(-50%, -50%) scale(0.88) rotate(-4deg)";
      window.setTimeout(() => {
        image.src = dish.image;
        image.alt = dish.name;
        category.textContent = dish.category;
        name.textContent = dish.name;
        ingredients.textContent = dish.ingredients;
        price.textContent = dish.price;
        image.style.opacity = "1";
        image.style.transform = "translate(-50%, -50%) scale(1) rotate(0deg)";
      }, 130);
    };

    document.querySelectorAll<HTMLElement>(".dish-thumb").forEach((button) => {
      const readDish = () => JSON.parse(button.dataset.dish ?? "{}") as Dish;

      button.addEventListener("click", () => serve(readDish()));
      button.addEventListener("dragstart", (event) => {
        event.dataTransfer?.setData("application/json", button.dataset.dish ?? "");
        table?.classList.add("scale-[1.02]", "ring-4", "ring-tomato/50");
      });
      button.addEventListener("dragend", () => {
        table?.classList.remove("scale-[1.02]", "ring-4", "ring-tomato/50");
      });
    });

    table?.addEventListener("dragover", (event) => event.preventDefault());
    table?.addEventListener("drop", (event) => {
      event.preventDefault();
      table.classList.remove("scale-[1.02]", "ring-4", "ring-tomato/50");
      const raw = event.dataTransfer?.getData("application/json");
      if (raw) serve(JSON.parse(raw) as Dish);
    });
  </script>
</section>
