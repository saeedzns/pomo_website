---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  label?: string;
}

const { href, variant = "primary", label } = Astro.props;
const styles = {
  primary: "bg-tomato text-white shadow-lg shadow-tomato/20 hover:bg-[#981d19]",
  secondary: "bg-olive text-white hover:bg-frame",
  ghost: "border border-ink/15 bg-paper/80 text-ink hover:bg-white",
};
---

<a
  href={href}
  aria-label={label}
  class:list={[
    "inline-flex min-h-11 items-center justify-center rounded-full px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] transition",
    styles[variant],
  ]}
>
  <slot />
</a>
