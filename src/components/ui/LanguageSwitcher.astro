---
import type { Language } from "../../data/site";

interface Props {
  lang: Language;
  path?: string;
}

const { lang, path = "" } = Astro.props;
const other = lang === "it" ? "en" : "it";
const href = `/${other}${path}`;
---

<a class="rounded-md border border-ink/15 px-3 py-2 text-sm font-bold uppercase text-ink hover:bg-white" href={href}>
  {other}
</a>
