---
import type { Language } from "../../data/site";

interface Props {
  lang: Language;
  path?: string;
}

const { lang, path = "" } = Astro.props;
const other = lang === "it" ? "en" : "it";
const href = `/${other}${path}`;
---

<a class="rounded-full border border-ink/15 px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] text-ink hover:bg-white" href={href}>
  {other}
</a>
