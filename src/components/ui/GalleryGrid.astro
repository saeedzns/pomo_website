---
const items = [
  { category: "Pasta", title: "Carbonara", image: "/images/menu/dish-carbonara.jpg" },
  { category: "Pasta", title: "Cacio e Pepe", image: "/images/menu/dish-cacio-pepe.jpg" },
  { category: "Pasta", title: "Amatriciana", image: "/images/menu/dish-amatriciana.jpg" },
  { category: "Pinsa", title: "Pinsa Margherita", image: "/images/menu/dish-pinsa-margherita.jpg" },
  { category: "Insalata", title: "Caprese", image: "/images/menu/dish-caprese.jpg" },
  { category: "Fritto", title: "Suppli", image: "/images/menu/dish-suppli.jpg" },
];
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item, index) => (
    <figure class:list={["group relative overflow-hidden rounded-lg bg-white shadow-soft", index === 1 ? "lg:row-span-2" : ""]}>
      <img
        src={item.image}
        alt={item.title}
        loading="lazy"
        class:list={[
          "w-full object-cover transition duration-500 group-hover:scale-105",
          index === 1 ? "h-full min-h-[28rem]" : "aspect-[4/3]",
        ]}
      />
      <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent p-5 text-white">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/70">{item.category}</p>
        <p class="mt-1 font-display text-3xl font-bold">{item.title}</p>
      </figcaption>
    </figure>
  ))}
</div>
