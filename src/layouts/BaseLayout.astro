---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import SEO from "../components/layout/SEO.astro";
import type { Language } from "../data/site";

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  path?: string;
  chrome?: boolean;
}

const { lang, title, description, path = "", chrome = true } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO lang={lang} title={title} description={description} path={path} />
  </head>
  <body>
    {chrome && <Navbar lang={lang} path={path} />}
    <main>
      <slot />
    </main>
    {chrome && <Footer lang={lang} />}
  </body>
</html>
