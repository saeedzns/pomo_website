---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import { dictionary } from "../../data/i18n";
import { site } from "../../data/site";
import { fullMenu } from "../../data/menu";

const lang = "it";
const t = dictionary[lang];
---

<BaseLayout lang={lang} path="/menu" title={`Menu | ${site.name} Roma`}>
  <section class="container-page max-w-4xl py-14 sm:py-20">
    <p class="eyebrow">Il menu</p>
    <h1 class="mt-3 font-display text-5xl font-bold sm:text-7xl">Cucina romana</h1>
    <p class="mt-5 max-w-2xl leading-7 text-ink/65">
      Pasta romana, pinse rosse, insalate e fritti. Prezzi e piatti sono portati dal file di riferimento `pomodorum-project`.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      {fullMenu.map((section) => (
        <a class="rounded-full border border-ink/15 bg-white/70 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em]" href={`#${section.category.toLowerCase().replace(/\s+/g, "-")}`}>
          {section.category}
        </a>
      ))}
    </div>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="menu-search">{t.menu.search}</label>
      <input id="menu-search" class="min-h-12 flex-1 rounded-full border border-ink/15 bg-white/80 px-5" type="search" placeholder={t.menu.search} />
      <Button href={site.currentMenuUrl} variant="secondary">{t.cta.fullMenu}</Button>
    </div>

    <div class="mt-16 space-y-16">
      {fullMenu.map((section) => (
        <section id={section.category.toLowerCase().replace(/\s+/g, "-")} class="scroll-mt-32">
          <h2 class="mb-6 font-display text-4xl font-bold text-tomato">{section.category}</h2>
          <ul class="divide-y divide-ink/10">
            {section.items.map((item) => (
              <li class="menu-row flex flex-col gap-2 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8" data-search={`${item.name} ${item.ingredients ?? ""} ${section.category}`.toLowerCase()}>
                <div>
                  <p class="font-display text-2xl font-bold">{item.name}</p>
                  {item.ingredients && <p class="mt-1 text-sm text-ink/60">{item.ingredients}</p>}
                </div>
                <p class="shrink-0 font-display text-2xl font-bold text-tomato">{item.price}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p id="no-results" class="hidden mt-10 rounded-lg bg-white p-5 font-bold">{t.menu.noResults}</p>
    <p class="mt-16 border-t border-ink/10 pt-8 text-center text-sm text-ink/55">Allergeni su richiesta · Walk-in only, no reservations</p>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>("#menu-search");
    const rows = [...document.querySelectorAll<HTMLElement>(".menu-row")];
    const empty = document.querySelector<HTMLElement>("#no-results");
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const match = row.dataset.search?.includes(query) ?? true;
        row.hidden = !match;
        if (match) visible += 1;
      });
      empty?.classList.toggle("hidden", visible !== 0);
    });
  </script>
</BaseLayout>
