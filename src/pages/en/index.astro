---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ContactButtons from "../../components/ui/ContactButtons.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import MenuShowcase from "../../components/sections/MenuShowcase.astro";
import { dictionary } from "../../data/i18n";
import { site } from "../../data/site";
import { featuredDishes } from "../../data/menu";

const lang = "en";
const t = dictionary[lang];
---

<BaseLayout lang={lang}>
  <section class="container-page grid min-h-[calc(100svh-8rem)] items-center gap-12 py-16 text-center lg:grid-cols-[0.95fr_1.05fr] lg:text-left">
    <div>
      <img src="/images/pomodorum-logo.jpg" alt={site.name} class="mx-auto mb-8 h-28 w-auto rounded-xl shadow-soft lg:mx-0" />
      <p class="eyebrow">{t.home.eyebrow}</p>
      <h1 class="hero-title mt-5">{site.name}</h1>
      <p class="mt-6 max-w-xl text-xl leading-8 text-ink/70">{t.home.headline}</p>
      <p class="mt-4 max-w-xl leading-7 text-ink/60">{t.home.subtitle}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
        <Button href="/en/menu">{t.cta.menu}</Button>
        <Button href="#table" variant="ghost">{t.cta.table}</Button>
        <Button href={site.googleMapsUrl} variant="secondary">{t.cta.directions}</Button>
      </div>
      <div class="mt-9 flex flex-wrap justify-center gap-x-5 gap-y-3 text-sm font-semibold text-ink/70 lg:justify-start">
        <span>No service charge</span>
        <span>Free Wi-Fi</span>
        <span>Ready in about 10 min</span>
      </div>
    </div>
    <div class="relative">
      <div class="grid grid-cols-2 gap-4">
        {featuredDishes.slice(0, 4).map((dish, index) => (
          <figure class:list={["overflow-hidden rounded-lg bg-white shadow-soft", index === 1 ? "translate-y-8" : ""]}>
            <img src={dish.image} alt={dish.name} class="aspect-[4/5] w-full object-cover" />
            <figcaption class="p-4 text-left">
              <p class="font-display text-2xl font-bold">{dish.name}</p>
              <p class="mt-1 text-sm text-tomato">{dish.price}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <MenuShowcase lang={lang} />

  <section class="container-page py-14">
    <SectionHeading title={t.home.quick} intro="Phone, directions, menu, and Google profile are always one tap away." />
    <div class="mt-6">
      <ContactButtons lang={lang} />
    </div>
  </section>

  <section class="container-page grid gap-10 py-14 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <p class="eyebrow">Visit us</p>
      <h2 class="mt-3 font-display text-4xl font-bold sm:text-6xl">Via Cavour 153, Rome</h2>
      <p class="mt-5 text-ink/65">Walk-in only. Roman pasta, pinsa, and fried starters served in a simple, direct setting.</p>
      <div class="mt-8 grid gap-3">
        {t.home.why.map((reason) => <p class="menu-rule py-3 font-semibold">{reason}</p>)}
      </div>
    </div>
    <div class="overflow-hidden rounded-lg shadow-soft ring-1 ring-ink/10">
      <iframe
        title="Pomodorum map"
        src="https://www.google.com/maps?q=Via%20Cavour%20153%2C%20Roma%2C%2000184%2C%20RM&output=embed"
        class="h-[420px] w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</BaseLayout>
