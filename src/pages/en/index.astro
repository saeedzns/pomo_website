---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedHero from "../../components/sections/AnimatedHero.astro";
import TrustBadges from "../../components/sections/TrustBadges.astro";
import LocationSection from "../../components/sections/LocationSection.astro";
import { site } from "../../data/site";

const lang = "en";
---

<BaseLayout
  lang={lang}
  chrome={false}
  title="Pomodorum Roma | Pasta Fresca & Pinsa Romana"
  description="Fresh pasta, pinsa romana, supplì, tiramisù and salads in Rome. No service charge."
>
  <AnimatedHero lang={lang} />
  <TrustBadges lang={lang} />
  <LocationSection lang={lang} />
  <footer class="border-t border-ink/10 bg-frame py-10 text-cream/80">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 px-6 sm:flex-row">
      <img src="/images/pomodorum-logo.jpg" alt={site.name} class="h-10 w-auto rounded-md" />
      <p class="text-center text-xs font-semibold uppercase tracking-[0.28em]">Via Cavour 153, Roma · {site.phoneDisplay}</p>
    </div>
  </footer>
</BaseLayout>
